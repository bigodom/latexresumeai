# Valores públicos do projeto Supabase. A publishable key é segura no navegador
# somente porque todas as tabelas usam Row Level Security.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# Chaves de IA, SUPABASE_SERVICE_ROLE_KEY e ALLOWED_ORIGINS são secrets da
# Edge Function e NUNCA devem ser adicionados a este arquivo ou prefixados VITE_.
